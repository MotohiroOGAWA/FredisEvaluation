{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FREDIS Evaluation Workbench",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/fredis-evaluation.code-workspace"
      ],
      "outFiles": [
        "${workspaceFolder}/src/**/*.js"
      ]
    }
  ]
}
